[user]
	email = 237797+mike2718@users.noreply.github.com
	name = mike
	signingkey = 19F253008884B5E7
[tar "tar.xz"]
	command = xz -c
[tar "tar.zst"]
	command = zstd -c
[commit]
	gpgsign = true
[safe]
	directory = C:/Users/Saori
	directory = C:/MSVCDev
	directory = C:/projects
[core]
	compression = 0
	quotepath = false
	autocrlf = false
	eol = lf
	editor = C:/cmdtool64/Sc1.exe
	fscache = true
	preloadindex = true
[init]
	defaultBranch = main
[merge]
	ff = false
[pull]
	ff = only
[push]
	autoSetupRemote = true
	default = simple
[http]
	retry = 3
	maxRequests = 4
	postBuffer = 524288000
	proxy = socks5://192.168.34.44:1080
[credential]
	helper = manager-core
[tag]
	gpgSign = true
[color]
	ui = auto
[diff]
	algorithm = histogram
[log]
	date = iso
[https]
	proxy = socks5://192.168.34.44:1080
[alias]
	acp = "!f() { git add -A && git commit -S -m \"$1\" && git push; }; f"
	cleanpull = !git reset --hard && git clean -fdx && git pull
[http "https://github.com"]
	proxy = socks5h://192.168.34.44:1080
